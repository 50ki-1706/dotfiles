{
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.key": "deny",
      "*.pem": "deny",
      "id_rsa*": "deny"
    },
    "bash": {
      "*": "ask",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "curl * | sh": "deny",
      "wget * | sh": "deny",
      "git reset --hard *": "deny",
      "git clean -fdx *": "deny"
    }
  }
}
