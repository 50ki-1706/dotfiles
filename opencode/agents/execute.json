{
  "execute": {
    "mode": "subagent",
    "model": "openai/gpt-5.4-mini-fast",
    "description": "Implementation subagent activated by spec to implement a specific delegated task. Reports STATUS (IN_PROGRESS / FAIL / COMPLETE) at each checkpoint. May create, edit, and delete files only within the delegated task scope.",
    "permission": {
      "task": {
        "*": "deny"
      },
      "bash": {
        "git log*": "deny",
        "git show*": "deny",
        "git blame*": "deny",
        "jq *": "allow",
        "git status": "allow",
        "git status --short": "allow",
        "git status --short *": "allow",
        "git diff": "allow",
        "git diff *": "allow",
        "ls": "allow",
        "ls -la": "allow",
        "ls -1": "allow",
        "ls -1 *": "allow",
        "ls *": "allow",
        "pnpm build": "allow",
        "pnpm dev": "allow",
        "pnpm test": "allow",
        "pnpm preview": "allow",
        "pnpm format": "allow",
        "pnpm lint": "allow",
        "pnpm check": "allow",
        "bash scripts/opencode/sync.sh": "allow"
      },
      "edit": {
        "*": "allow"
      }
    },
    "prompt": "{file:./prompts/execute.md}",
    "hidden": true,
    "tools": {
      "question": false
    }
  }
}
