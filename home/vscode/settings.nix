    "chat.tools.terminal.autoApprove" = {
      "docker compose" = true;
      "/^python - <<'PY'\nimport heapq\nfrom collections import defaultdict\nedges=\\[\\]\nwith open\\('/Users/koki/Documents/INIAD/spring_2026/algo/algo/05/dij\\.edgelist'\\) as f:\n    for line in f:\n        u,v,w=map\\(int,line\\.split\\(\\)\\)\n        edges\\.append\\(\\(u,v,w\\)\\)\n\nadj=defaultdict\\(list)\nverts=set\\(\\)\nfor u,v,w in edges:\n    adj\\[u\\]\\.append\\(\\(v,w\\)\\)\n    adj\\[v\\]\\.append\\(\\(u,w\\)\\)\n    verts\\.update\\(\\[u,v\\]\\)\n\nstart=min\\(verts\\)\nvisited=\\{start\\}\nheap=\\[\\]\nfor v,w in adj\\[start\\]: heapq\\.heappush\\(heap,\\(w,start,v\\)\\)\nmst=\\[\\]\nwhile heap and len\\(visited\\)<len\\(verts\\):\n    w,u,v=heapq\\.heappop\\(heap)\n    if v in visited: continue\n    visited\\.add\\(v)\n    mst\\.append\\(\\(u,v,w\\)\\)\n    for nv,nw in adj\\[v\\]:\n        if nv not in visited:\n            heapq\\.heappush\\(heap,\\(nw,v,nv\\)\\)\nprint\\(mst\\)\nprint\\(sum\\(w for \\*_,w in mst\\)\\)\nPY$/'" =
        {
          approve = true;
          matchCommandLine = true;
        };
    };
